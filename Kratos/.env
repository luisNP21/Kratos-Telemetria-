# ==============================================================================
# KRATOS FSAE TELEMETRÍA — VARIABLES DE ENTORNO CENTRALIZADAS
# Arquitectura Raspberry Pi 5 (Ubuntu / Debian ARM64)
# ==============================================================================

# Configuración General
TZ=America/Bogota
CAN_INTERFACE=vcan0

# InfluxDB 2.7 — Almacenamiento Local Persistente (Caja Negra NVMe)
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=kratos_influx_pass
DOCKER_INFLUXDB_INIT_ORG=kratos_fsae
DOCKER_INFLUXDB_INIT_BUCKET=telemetria_carro
DOCKER_INFLUXDB_INIT_RETENTION=0s
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=kratos-fsae-telemetry-token-2026

# Grafana — Visualización en Pits / Local
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=kratos_grafana_pass
GF_USERS_ALLOW_SIGN_UP=false

